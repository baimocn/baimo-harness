{
  "name": "baimo-harness",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "baimo-harness",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22.19.0"
      }
    },
    "apps/agent-host": {
      "name": "@baimo-harness/agent-host",
      "version": "0.0.0"
    },
    "apps/desktop": {
      "name": "@baimo-harness/desktop",
      "version": "0.0.0"
    },
    "node_modules/@baimo-harness/agent-host": {
      "resolved": "apps/agent-host",
      "link": true
    },
    "node_modules/@baimo-harness/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@baimo-harness/desktop": {
      "resolved": "apps/desktop",
      "link": true
    },
    "node_modules/@baimo-harness/rpc": {
      "resolved": "packages/rpc",
      "link": true
    },
    "node_modules/@baimo-harness/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "packages/core": {
      "name": "@baimo-harness/core",
      "version": "0.0.0"
    },
    "packages/rpc": {
      "name": "@baimo-harness/rpc",
      "version": "0.0.0"
    },
    "packages/ui": {
      "name": "@baimo-harness/ui",
      "version": "0.0.0"
    }
  }
}
